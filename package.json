{
  "name": "half-fixed",
  "version": "0.1.1",
  "description": "Find bug fixes that reached some sibling implementations but not the others. A git-history scanner plus Agent Skills for Claude Code, Codex, and any SKILL.md agent.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "half-fixed": "bin/half-fixed.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:fallback": "node scripts/fallback.js build",
    "build:demo": "node scripts/render-demo.js",
    "build:art": "node scripts/render-readme-art.js",
    "check:metadata": "node scripts/metadata.js",
    "check:fallback": "node scripts/fallback.js check",
    "check:package": "node scripts/smoke-pack.js",
    "check:node-help": "node skills/half-fixed/scripts/half-fixed.js --help",
    "release": "node scripts/release.js",
    "half-fixed": "bun run ./bin/half-fixed.js",
    "test": "bun test ./test/*.test.js",
    "test:coverage": "bun test ./test/*.test.js --coverage --coverage-reporter=lcov --coverage-dir=coverage && node scripts/coverage.js coverage/lcov.info src && bun run check:fallback"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "skill-md",
    "git",
    "static-analysis",
    "bug-finding",
    "code-review",
    "open-source",
    "cli"
  ],
  "author": {
    "name": "Zain Ali",
    "url": "https://github.com/heyzainali"
  },
  "homepage": "https://github.com/heyzainali/half-fixed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyzainali/half-fixed.git"
  },
  "bugs": {
    "url": "https://github.com/heyzainali/half-fixed/issues"
  },
  "license": "MIT",
  "devDependencies": {}
}
